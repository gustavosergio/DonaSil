{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "loja-dona-sil",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-26",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "routes": [
    { "pattern": "donasilmodafeminina.com.br", "custom_domain": true },
    { "pattern": "www.donasilmodafeminina.com.br", "custom_domain": true }
  ],
  "keep_vars": true,
  "vars": {
    "FRETE_PESO_PECA_KG": "0.5",
    "FRETE_ALTURA_PECA_CM": "25",
    "FRETE_LARGURA_PECA_CM": "20",
    "FRETE_COMPRIMENTO_PECA_CM": "20"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "loja-dona-sil"
    }
  ]
}
